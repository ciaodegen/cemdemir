{
  "name": "normalin-tarihi",
  "version": "1.0.0",
  "private": true,
  "description": "Normalin Tarihi — Instagram Reels production system (Remotion)",
  "scripts": {
    "studio": "remotion studio",
    "timing": "node scripts/build-timing.mjs",
    "tts": "node scripts/generate-narration.mjs",
    "render:ep01": "node scripts/build-timing.mjs 01 && remotion render Ep01 out/normalin-tarihi-ep01.mp4",
    "stills": "node scripts/stills.mjs",
    "cover:ep01": "remotion still Ep01Cover out/normalin-tarihi-ep01-cover.png",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/inter": "5.1.1",
    "@remotion/cli": "4.0.537",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.537"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "tsx": "4.19.2",
    "typescript": "5.6.3"
  }
}
